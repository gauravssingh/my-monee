<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example LaunchAgent for Phase 6.
  Copy to ~/Library/LaunchAgents/com.personal.expense-tracker.plist
  and update ProgramArguments paths to your install.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.personal.expense-tracker</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/YOU/projects/expense-tracker/.venv/bin/python</string>
      <string>-m</string>
      <string>expense_tracker</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOU/projects/expense-tracker</string>
    <key>StandardOutPath</key>
    <string>/Users/YOU/Library/Logs/ExpenseTracker/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/Library/Logs/ExpenseTracker/stderr.log</string>
  </dict>
</plist>
